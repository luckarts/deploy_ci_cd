# Portfolio — production environment template
# Copy to .env.prod and fill the secrets.
# This file is versioned; the real .env.prod is gitignored.

# Deployment identity
ENV=prod
FRONTEND_HOST=bachelart.fr
IMAGE_TAG=latest-prod
COMPOSE_PROJECT_NAME=portfolio-prod

# Application
APP_NAME="Portfolio"

# Postgres
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGEME_GENERATE_STRONG_PASSWORD

# Better Auth
BETTER_AUTH_SECRET=CHANGEME_RUN_openssl_rand_base64_32

# Resend (transactional email — optional)
RESEND_API_KEY=

# URLs
FRONTEND_URL=https://bachelart.fr

# Watchtower (auto-redéploiement)
# WATCHTOWER_MONITOR_ONLY: si true → watchtower surveille sans redémarrer (utile pour staging)
WATCHTOWER_MONITOR_ONLY=false