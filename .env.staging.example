# Portfolio — staging environment template
# Copy to .env.staging and fill the secrets.
# This file is versioned; the real .env.staging is gitignored.

# Deployment identity
ENV=staging
FRONTEND_HOST=staging.bachelart.fr
IMAGE_TAG=latest-staging
COMPOSE_PROJECT_NAME=portfolio-staging

# Application
APP_NAME="Portfolio (Staging)"

# Postgres
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGEME_GENERATE_STRONG_PASSWORD

# Better Auth
BETTER_AUTH_SECRET=CHANGEME_RUN_openssl_rand_base64_32

# Resend (transactional email — optional)
RESEND_API_KEY=

# URLs
FRONTEND_URL=https://staging.bachelart.fr

# Watchtower (auto-redéploiement)
# Staging : mode dry-run par défaut — ne redémarre pas les conteneurs
WATCHTOWER_MONITOR_ONLY=true