# Monitoring stack — copy to .env.monitoring and fill in.
# This file is versioned; the real .env.monitoring is gitignored.

GRAFANA_ADMIN_PASSWORD=CHANGEME_GENERATE_STRONG_PASSWORD

# SMTP for Alertmanager email notifications (optional)
ALERTMANAGER_SMTP_USERNAME=
ALERTMANAGER_SMTP_PASSWORD=

# uid/gid CrowdSec runs as on the host
PGID=1000
PUID=1000
