{{ define "email.subject" }}
[ALERTE] {{ .GroupLabels.alertname }} — {{ .Status | title }}
{{ end }}

{{ define "email.default.html" }}
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; padding: 20px; }
  .alert { border-left: 4px solid; padding: 12px; margin: 8px 0; border-radius: 4px; }
  .alert-firing { border-color: #e74c3c; background: #fdf0ef; }
  .alert-resolved { border-color: #27ae60; background: #eafaf1; }
  h2 { color: #2c3e50; }
  table { width: 100%; border-collapse: collapse; }
  td, th { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
  th { background: #f8f9fa; }
</style>
</head>
<body>
<h1>Poker Training — Alertes Monitoring</h1>
<p>{{ .Alerts.Firing | len }} alerte(s) en cours, {{ .Alerts.Resolved | len }} résolue(s)</p>

{{ if .Alerts.Firing }}
<h2>🔴 Alertes actives</h2>
{{ range .Alerts.Firing }}
<div class="alert alert-firing">
  <strong>{{ .Labels.alertname }}</strong>
  <p>{{ .Annotations.description }}</p>
  <table>
    <tr><td>Sévérité</td><td>{{ .Labels.severity }}</td></tr>
    <tr><td>Instance</td><td>{{ .Labels.instance }}</td></tr>
    <tr><td>Démarrée</td><td>{{ .StartsAt.Format "2006-01-02 15:04:05" }}</td></tr>
  </table>
</div>
{{ end }}
{{ end }}

{{ if .Alerts.Resolved }}
<h2>✅ Alertes résolues</h2>
{{ range .Alerts.Resolved }}
<div class="alert alert-resolved">
  <strong>{{ .Labels.alertname }}</strong>
  <p>{{ .Annotations.description }}</p>
  <table>
    <tr><td>Instance</td><td>{{ .Labels.instance }}</td></tr>
    <tr><td>Résolue</td><td>{{ .EndsAt.Format "2006-01-02 15:04:05" }}</td></tr>
  </table>
</div>
{{ end }}
{{ end }}

<hr>
<p style="color: #7f8c8d; font-size: 12px;">
  Poker Training — Monitoring Stack<br>
  <a href="https://monitoring.bachelart.fr">https://monitoring.bachelart.fr</a>
</p>
</body>
</html>
{{ end }}